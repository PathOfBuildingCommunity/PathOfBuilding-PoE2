# Copy to .env (never commit .env).

# compose.enhanced.yml (build from source) and compose.image.yml (prebuilt image)
POB2_PORT=8080
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from your network. There is no login, so only expose it
# on a network you trust (or use compose.tailscale.yml).
POB2_BIND=127.0.0.1
# Hostnames/IPs other machines use to reach /mcp (comma-separated); localhost always works.
POB2_ALLOWED_HOSTS=
# compose.image.yml only: image to run
# POB2_IMAGE=ghcr.io/skitty4fingers/pob-enhanced:latest

# compose.tailscale.yml
# Auth key: https://login.tailscale.com/admin/settings/keys (reusable not needed; state is persisted)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Your tailnet DNS name: admin console -> DNS -> "Tailnet name", e.g. tail1234.ts.net
TS_TAILNET=tail1234.ts.net
TS_HOSTNAME=pob2
# Optional, e.g. --advertise-tags=tag:pob2 (the tag must exist in your ACL policy)
TS_EXTRA_ARGS=
