# Copy to .env (never commit .env).

# Host port for compose.enhanced.yml (localhost only)
POB2_PORT=8080

# compose.tailscale.yml
# Auth key: https://login.tailscale.com/admin/settings/keys (reusable not needed; state is persisted)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Your tailnet DNS name: admin console -> DNS -> "Tailnet name", e.g. tail1234.ts.net
TS_TAILNET=tail1234.ts.net
TS_HOSTNAME=pob2
# Optional, e.g. --advertise-tags=tag:pob2 (the tag must exist in your ACL policy)
TS_EXTRA_ARGS=
